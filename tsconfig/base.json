{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Anchored to `bun init` defaults. TS 7 always resolves as bundler with esModuleInterop, and defaults strict and resolveJsonModule on.
	"compilerOptions": {
		"lib": ["ESNext"], // no DOM globals in base — dom adds them back
		"target": "ESNext", // TS 7 defaults to ES2025, and Vite reads this for class-field emit
		"module": "Preserve", // the bundler/runtime owns modules; tsc emits nothing anyway
		"moduleDetection": "force", // every file is a module — no global-script identifier collisions
		"jsx": "react-jsx", // inert without .tsx
		"allowJs": true,
		"checkJs": true,
		"types": ["bun"],

		"allowImportingTsExtensions": true, // Bun-style explicit `./x.ts` imports
		"verbatimModuleSyntax": true, // type-only imports must say `import type`; implies isolatedModules
		"erasableSyntaxOnly": true, // no enums, namespaces or parameter properties: Bun and Node strip types, they don't compile them
		"noEmit": true, // tsc checks, never builds — bundlers own emit (ui repo: tsdown)

		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true, // arr[i] is T | undefined — closes strict mode's soundness hole
		"noImplicitOverride": true,
		"allowUnreachableCode": false // the default only greys it out in the editor
	},
	"exclude": ["${configDir}/**/dist", "${configDir}/**/target"] // built .ts and .d.ts output would be checked as source
}
