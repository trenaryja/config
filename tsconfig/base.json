{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Anchored to `bun init` defaults. Omitted options are implied by `module: "Preserve"`
	// (moduleResolution: bundler, esModuleInterop) or are already TS defaults.
	"compilerOptions": {
		"lib": ["ESNext"], // no DOM globals in base — next/vite add them back
		"target": "ESNext",
		"module": "Preserve", // the bundler/runtime owns modules; tsc emits nothing anyway
		"moduleDetection": "force", // every file is a module — no global-script identifier collisions
		"jsx": "react-jsx", // inert without .tsx
		"allowJs": true,
		"types": ["bun"],

		"allowImportingTsExtensions": true, // Bun-style explicit `./x.ts` imports
		"verbatimModuleSyntax": true, // type-only imports must say `import type`; implies isolatedModules
		"noEmit": true, // tsc checks, never builds — bundlers own emit (ui repo: tsup)

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true, // arr[i] is T | undefined — closes strict mode's soundness hole
		"noImplicitOverride": true,

		"resolveJsonModule": true // deviation from bun init: repos import JSON; tsc needs this to type it
	}
}
