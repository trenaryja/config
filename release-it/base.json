{
	"hooks": { "before:init": "bun run ci" },
	"git": {
		"commitMessage": "chore(release): v${version} [skip ci]"
	},
	"github": {
		"release": true
	},
	"npm": {
		"publish": false
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": { "name": "conventionalcommits", "preMajor": true }
		}
	}
}
