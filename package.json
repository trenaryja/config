{
	"name": "@trenaryja/config",
	"version": "0.0.8",
	"description": "Shared configs: eslint, tsconfig, prettier, renovate, release-it",
	"license": "MIT",
	"author": "Justin Trenary",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trenaryja/config.git"
	},
	"type": "module",
	"exports": {
		"./eslint": {
			"types": "./eslint.d.ts",
			"default": "./eslint.js"
		},
		"./prettier": "./prettier.json",
		"./release-it": "./release-it.json",
		"./tsconfig/*": "./tsconfig/*.json",
		"./package.json": "./package.json"
	},
	"files": [
		"eslint.js",
		"eslint.d.ts",
		"prettier.json",
		"release-it.json",
		"tsconfig"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"dev": "bun fleet --serve",
		"fix": "prettier -w . && eslint --fix .",
		"check": "tsc && prettier -c . && eslint . --max-warnings=0",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install",
		"release": "release-it"
	},
	"dependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.4.0",
		"@types/bun": "^1.4.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.13.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"is-bun-module": "^2.0.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1"
	},
	"devDependencies": {
		"release-it": "^21.1.1",
		"remeda": "^2.52.0",
		"zod": "^4.6.7"
	},
	"prettier": "@trenaryja/config/prettier",
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version} [skip ci]"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		}
	},
	"trustedDependencies": [
		"unrs-resolver"
	]
}
