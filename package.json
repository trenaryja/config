{
	"name": "@trenaryja/config",
	"version": "0.2.2",
	"description": "Shared configs: eslint, tsconfig, prettier, renovate, release-it",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trenaryja/config.git"
	},
	"license": "MIT",
	"author": "Justin Trenary",
	"type": "module",
	"exports": {
		"./eslint": {
			"types": "./eslint.d.ts",
			"default": "./eslint.js"
		},
		"./prettier": "./prettier.json",
		"./release-it": "./release-it.json",
		"./tsconfig/*": "./tsconfig/*.json",
		"./package.json": "./package.json"
	},
	"bin": {
		"tren": "./tren/index.ts"
	},
	"files": [
		"eslint.js",
		"eslint.d.ts",
		"eslint-rules.gen.d.ts",
		"lib",
		"prettier.json",
		"release-it.json",
		"default.json",
		"tsconfig",
		"tren",
		"!tren/**/node_modules"
	],
	"scripts": {
		"chk": "bun tren/index.ts chk && bun fleet lint redundant",
		"ci": "bun tren/index.ts ci",
		"dev": "bun fleet --serve",
		"fix": "bun typegen.ts && bun tren/index.ts fix",
		"prepare": "bun typegen.ts",
		"release": "GITHUB_TOKEN=$(gh auth token) release-it"
	},
	"prettier": "@trenaryja/config/prettier",
	"dependencies": {
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.4.2",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/bun": "1.4.3",
		"eslint": "10.13.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-de-morgan": "2.2.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y-x": "0.2.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-unicorn": "78.0.0",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"release-it": "21.1.1",
		"remeda": "2.53.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"eslint-typegen": "2.3.1"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"release-it": {
		"extends": "./release-it.json"
	},
	"trustedDependencies": [
		"unrs-resolver"
	]
}
