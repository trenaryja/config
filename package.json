{
	"name": "@trenaryja/config",
	"version": "0.0.8",
	"description": "Shared configs: eslint, tsconfig, prettier, renovate, release-it",
	"license": "MIT",
	"author": "Justin Trenary",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trenaryja/config.git"
	},
	"type": "module",
	"exports": {
		"./eslint": "./eslint.js",
		"./prettier": "./prettier.json",
		"./release-it": "./release-it.json",
		"./tsconfig/*": "./tsconfig/*.json",
		"./package.json": "./package.json"
	},
	"files": [
		"eslint.js",
		"prettier.json",
		"release-it.json",
		"tsconfig"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"dev": "bun fleet --serve",
		"fix": "prettier -w . && eslint --fix .",
		"check": "prettier -c . && eslint . --max-warnings=0",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install",
		"release": "release-it"
	},
	"dependencies": {
		"@fullstacksjs/eslint-config": "^15.2.0",
		"@types/bun": "^1.4.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.11.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.9.8",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"release-it": "^21.1.0",
		"remeda": "^2.50.0"
	},
	"prettier": "@trenaryja/config/prettier",
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version} [skip ci]"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		}
	},
	"trustedDependencies": [
		"unrs-resolver"
	]
}
